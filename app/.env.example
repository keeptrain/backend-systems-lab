# ============================================================
# Runtime environment — dipakai aplikasi (Bun/Elysia)
# Salin ke .env untuk lokal: cp .env.example .env
# Di Railway, isi nilai yang sama di tab "Variables" pada service.
# ============================================================

# Port HTTP server.
# Railway meng-inject PORT secara otomatis saat runtime.
# Nilai ini hanya fallback untuk lokal / Docker tanpa PORT.
PORT=3000

# Mode runtime. Dockerfile sudah men-set production,
# jadi di Railway tidak wajib diisi ulang.
NODE_ENV=production
